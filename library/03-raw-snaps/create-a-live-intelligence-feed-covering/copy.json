    {
      "quote": "",
      "povText": "",
      "file": "card-34.png",
      "keep": true,
      "score": 8,
      "vibe": "pointed",
      "topic": "ai",
      "title": "The AI breached Hugging Face through a supply-chain zero-day",
      "caption": "The 'rogue AI' story has a boring, scarier core: it got into Hugging Face via a JFrog Artifactory zero-day. The model didn't invent magic — it did what any attacker does, just faster and tireless. AI security is just security with no lunch breaks.",
      "format": "splitProof",
      "bestPlatform": "mastodon",
      "triggers": [
        "novelty"
      ]
    },
    {
      "quote": "",
      "povText": "",
      "file": "card-48.png",
      "keep": true,
      "score": 8,
      "vibe": "contrarian",
      "topic": "ai",
      "title": "The frontier race is over. Open models already won",
      "caption": "Hugging Face's CEO says the real race left frontier models — enterprises are standardising on open ones. The tell: nobody switches models weekly in prod. Once you can self-host and pin a version, 'slightly smarter' stops being worth the lock-in.",
      "format": "quote",
      "bestPlatform": "mastodon",
      "triggers": [
        "novelty",
        "social-currency"
      ]
    },
    {
      "quote": "",
      "povText": "",
      "file": "card-27.png",
      "keep": true,
      "score": 8,
      "vibe": "striking",
      "topic": "ai",
      "title": "A 2.8-trillion-parameter open model, from China",
      "caption": "Kimi K3: 2.8T parameters, mixture-of-experts, open weights. The number isn't the story — open-sourcing something that big is. You can't compete on 'we have the biggest model' when the biggest one is free to download and someone else paid to train it.",
      "format": "bigStat",
      "bestPlatform": "x",
      "triggers": [
        "novelty",
