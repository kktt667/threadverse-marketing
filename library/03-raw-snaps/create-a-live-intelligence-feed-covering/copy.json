      ]
    },
    {
      "quote": "",
      "povText": "",
      "file": "card-16.png",
      "keep": true,
      "score": 7,
      "vibe": "wry",
      "topic": "ai",
      "title": "Microsoft shipped a security AI that undercuts on price",
      "caption": "Microsoft's first cybersecurity model claims to beat rivals on the benchmark at half the cost. Notice the pattern: every new frontier model now launches as a *price* move, not a capability one. The moat stopped being smart and started being cheap.",
      "format": "tabloid",
      "bestPlatform": "mastodon",
      "triggers": [
        "novelty"
      ]
    },
    {
      "quote": "",
      "povText": "",
      "file": "card-45.png",
      "keep": true,
      "score": 8,
      "vibe": "shift",
      "topic": "ai",
      "title": "Gemma 4 runs on the Pixel with no internet",
      "caption": "Google's Gemma 4 now runs fully on the Pixel 10, offline. The quiet consequence: once the model lives on your phone, the business model built on metering API calls has nothing to meter. On-device isn't a feature, it's a pricing extinction event.",
      "format": "minimal",
      "bestPlatform": "mastodon",
      "triggers": [
        "novelty"
      ]
    },
    {
      "quote": "",
      "povText": "",
      "file": "card-03.png",
      "keep": true,
      "score": 7,
      "vibe": "skeptical",
      "topic": "ai",
      "title": "'Create anything' is the tell, not the pitch",
      "caption": "Google says Gemini Omni can 'create anything with any input.' When a model's headline feature is that it has no specific feature, you're looking at a demo, not a product. 'Does everything' is what you say when you haven't found the one thing it's for.",
      "format": "quote",
      "bestPlatform": "x",
      "triggers": [
        "emotion",
